# =============================================================================
# Production Rumahweb — wedding-invitation-api
# Copy ke .env di server: /home/sank9295/public_html/api.wedding-invitation.sanadwi.my.id/.env
# =============================================================================

APP_NAME="Wedding Invitation API"
APP_ENV=production
APP_KEY=base64:ISI_DENGAN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://api.wedding-invitation.sanadwi.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (sesuaikan dari cPanel → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sank9295_wedding_invitation
DB_USERNAME=sank9295_wedding
DB_PASSWORD=ISI_PASSWORD_DB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.sanadwi.my.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- SPA / Sanctum (frontend production) ---
FRONTEND_URL=https://wedding-invitation.sanadwi.my.id
SANCTUM_STATEFUL_DOMAINS=wedding-invitation.sanadwi.my.id,api.wedding-invitation.sanadwi.my.id
CORS_ALLOWED_ORIGINS=https://wedding-invitation.sanadwi.my.id

# --- DOKU SANDBOX (tes tanpa uang real) ---
DOKU_CLIENT_ID=ISI_CLIENT_ID_SANDBOX
DOKU_SECRET_KEY=ISI_SECRET_KEY_SANDBOX
DOKU_SANDBOX=true
DOKU_NOTIFICATION_PATH=/api/doku/notification

# --- FlowKirim WhatsApp (kirim undangan) ---
# Host marketing api.flowkirim.com sering tidak resolve DNS — pakai scan.flowkirim.com
FLOWKIRIM_API_TOKEN=ISI_TOKEN_DARI_DASHBOARD
FLOWKIRIM_BASE_URL=https://scan.flowkirim.com
FLOWKIRIM_SEND_PATH=/api/whatsapp/messages/text
FLOWKIRIM_TIMEOUT=20
FLOWKIRIM_DEVICE_FIELD=session_id
FLOWKIRIM_APPEND_JID_SUFFIX=true
FLOWKIRIM_LINK_PREVIEW=true
# Keep mixed Arabic+Latin invitation text left-aligned in WhatsApp (Unicode LRM).
FLOWKIRIM_FORCE_LTR=true

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
